# ==============================================================================
# Week 8 Capstone: Environment Configuration Template
# ==============================================================================
# IMPORTANT: Never commit the active '.env' file containing production secrets.
# Copy this file to '.env' and provide your local credentials and provider keys:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Configuration (PostgreSQL / Relational Store)
# ------------------------------------------------------------------------------
POSTGRES_DB=librarydb_week3
POSTGRES_USER=postgres
POSTGRES_PASSWORD=private
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# 2. Authentication & JWT Security
# ------------------------------------------------------------------------------
# Must be at least 256 bits (32+ characters) long
JWT_KEY=SuperSecretWeek08ProductionHardenedSigningKeyMustBe32CharsLong!
JWT_ISSUER=LibraryApi
JWT_AUDIENCE=LibraryClient
JWT_EXPIRE_MINUTES=60

# ------------------------------------------------------------------------------
# 3. AI Service Orchestration (FastAPI + LangGraph)
# ------------------------------------------------------------------------------
SERVICE_KEY=sec-auth-token-internal-fastapi-comm-week08-secure-2026
DOTNET_API_URL=http://api:8080
FASTAPI_API_URL=http://ai-service:8000

# External LLM Providers (Configure at least one)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Model Selection
DEFAULT_ROUTER_MODEL=gemini-1.5-flash
DEFAULT_REASONING_MODEL=gemini-1.5-pro
EMBEDDING_MODEL=text-embedding-3-small

# ------------------------------------------------------------------------------
# 4. Storage & Vector Database
# ------------------------------------------------------------------------------
CHROMA_PERSIST_DIRECTORY=/data/chroma
SQLITE_CHECKPOINT_PATH=/data/checkpoints/agent_checkpoints.sqlite

# ------------------------------------------------------------------------------
# 5. Application Gateway & API Runtime (.NET)
# ------------------------------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_HTTP_PORTS=8080
API_HOST_PORT=5000
RUN_MIGRATIONS=true
DAILY_TOKEN_BUDGET=25000
MAX_QUESTION_LENGTH=1000

# ------------------------------------------------------------------------------
# 6. Web Client (Angular 18)
# ------------------------------------------------------------------------------
WEB_HOST_PORT=4200
ANGULAR_API_BASE_URL=http://localhost:5000
